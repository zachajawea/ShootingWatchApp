<?xml version="1.0"?>
<!--
    Connect IQ application manifest.

    Notes on the parts that matter for this app:
      * <iq:permissions> MUST contain "Sensor". Without it, the call to
        Sensor.registerSensorDataListener() throws a permission error at
        runtime and the app is rejected at store submission.
      * "Fit" is required for the optional .FIT export: ActivityRecording +
        FitContributor write each string as a Garmin Connect activity. Devices
        that lack ActivityRecording simply skip the export (the code guards it),
        so the permission does not restrict the product list below.
      * minApiLevel is 3.2.0 because we rely on getMaxSampleRateForSensorType()
        and the high-frequency sensor-data listener with timestamps/power.
      * Replace the id attribute with your own UUID before building for the
        store (the SDK's "New Project" wizard, or `monkeyc`/VS Code, generates
        one for you). The value below is a valid placeholder UUID.
      * The product list below is a representative set of accelerometer-capable
        wrist devices. Add/remove products to match your target hardware; every
        product you list must support Toybox.Sensor.AccelerometerData.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="ShootingWatchAppApp" id="a1b2c3d4e5f64a7b8c9d0e1f2a3b4c5d" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0" name="@Strings.AppName" type="watch-app">
        <iq:products>
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fr255"/>
            <iq:product id="fr265"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="instinct3amoled45mm"/>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
            <iq:product id="vivoactive5"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Sensor"/>
            <iq:uses-permission id="Fit"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>